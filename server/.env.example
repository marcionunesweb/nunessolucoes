# Copie para .env e preencha antes de rodar.

# Gere com: openssl rand -hex 32
JWT_SECRET=

# Porta que o servidor Node escuta (o Caddy/nginx na frente é que expõe 443)
PORT=4000

# Onde fica o arquivo do banco SQLite
DB_PATH=./data/app.db

# production ativa cookie "secure" (exige HTTPS) — deixe assim atrás do Caddy
NODE_ENV=production
