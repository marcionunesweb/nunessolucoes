# Copie para .env e preencha antes de rodar.

# Gere com: openssl rand -hex 32
JWT_SECRET=

# Porta que o servidor Node escuta (quem expõe 443 é o proxy na frente —
# Caddy no docker-compose, ou o OpenLiteSpeed do CyberPanel)
PORT=4000

# Deixe 0.0.0.0 pro docker-compose. Atrás de um painel (CyberPanel) no
# mesmo host, use 127.0.0.1 — só o proxy local precisa alcançar a porta.
HOST=0.0.0.0

# Onde fica o arquivo do banco SQLite
DB_PATH=./data/app.db

# production ativa cookie "secure" (exige HTTPS) — deixe assim atrás
# do Caddy ou do CyberPanel com SSL emitido
NODE_ENV=production
